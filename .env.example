# API 配置
OPENAI_API_KEY=sk-your-key-here

# API 基础地址 (默认 OpenAI，兼容 OpenAI 协议的第三方服务可修改此项)
OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 模型选择
OPENAI_MODEL=mimo-v2.5-pro

# HuggingFace Token (可选，加速模型下载)
HF_TOKEN=hf_your_token_here

# Chroma 持久化目录 (默认 ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# 高德地图 API Key (申请: https://console.amap.com/dev/key)
AMAP_API_KEY=your_amap_key_here

# 日志级别 (DEBUG / INFO / WARNING / ERROR, 默认 INFO)
LOG_LEVEL=INFO
